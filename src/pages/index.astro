---
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Layout from '../layouts/Layout.astro';

if (Astro.locals.user) {
	return Astro.redirect('/app');
}

const FEATURES = [
	{
		icon: '🔗',
		title: 'Guarda cualquier enlace',
		description:
			'Pega la URL y listo: título, descripción y favicon se completan automáticamente.',
	},
	{
		icon: '🏷️',
		title: 'Categorías múltiples',
		description:
			'Organiza cada enlace en una o varias categorías, a tu manera.',
	},
	{
		icon: '🔍',
		title: 'Búsqueda instantánea',
		description: 'Encuentra lo que buscas por nombre o dominio en segundos.',
	},
	{
		icon: '📝',
		title: 'Notas personales',
		description: 'Agrega contexto propio a cada enlace que guardes.',
	},
	{
		icon: '🌓',
		title: 'Modo claro y oscuro',
		description: 'La interfaz se adapta a tu preferencia, cuando quieras.',
	},
	{
		icon: '🔒',
		title: 'Privado y tuyo',
		description: 'Tu cuenta, tus enlaces. Nadie más los ve.',
	},
];
---

<Layout title="LinksStore — guarda y organiza tus enlaces favoritos">
	<div class="flex min-h-screen flex-col">
		<header class="sticky top-0 z-50 px-4 pt-4 lg:px-8">
			<div class="rise border-line bg-surface/80 rounded-cards mx-auto flex max-w-6xl items-center gap-2 border px-4 py-3 backdrop-blur-md">
				<Logo href="/" />

				<div class="ml-auto flex items-center gap-3">
					<ThemeToggle />
					<a
						href="/login"
						class="rounded-buttons border-line text-ink hover:bg-surface-elevated border px-3 py-1.5 text-sm font-medium transition hover:-translate-y-0.5"
					>
						Iniciar sesión
					</a>
					<a
						href="/register"
						class="rounded-buttons bg-primary text-on-primary hover:bg-primary-active hidden px-3 py-1.5 text-sm font-semibold transition hover:-translate-y-0.5 sm:inline-block"
					>
						Crear cuenta
					</a>
				</div>
			</div>
		</header>

		<main class="flex-1">
			<section class="mx-auto max-w-4xl px-4 py-20 text-center lg:px-8 lg:py-28">
				<span class="rise rise-1 border-primary/30 bg-surface/60 text-muted mx-auto inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs font-medium backdrop-blur-sm">
					<span class="bg-primary h-2 w-2 rounded-full"></span>
					Tu gestor personal de enlaces
				</span>

				<h1 class="text-ink mt-6 text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl">
					<span class="rise rise-2 block">Guarda cualquier enlace.</span>
					<span class="rise rise-3 block">
						<span class="text-muted">Encuéntralo </span>
						<span class="text-primary">cuando lo necesites.</span>
					</span>
				</h1>

				<p class="rise rise-4 text-muted mx-auto mt-6 max-w-xl text-lg text-balance">
					LinksStore es tu bóveda personal de páginas útiles — con categorías,
					búsqueda instantánea y notas propias, todo en un solo lugar.
				</p>

				<div class="rise rise-5 mt-8 flex flex-wrap items-center justify-center gap-3">
					<a
						href="/register"
						class="rounded-buttons bg-primary text-on-primary hover:bg-primary-active px-6 py-3 text-sm font-semibold transition hover:-translate-y-0.5"
					>
						Crear cuenta gratis
					</a>
					<a
						href="/login"
						class="rounded-buttons border-line text-ink hover:bg-surface-elevated border px-6 py-3 text-sm font-medium transition hover:-translate-y-0.5"
					>
						Iniciar sesión
					</a>
				</div>
			</section>

			<section class="border-line border-t">
				<div class="mx-auto max-w-6xl px-4 py-16 lg:px-8">
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
						{FEATURES.map((feature) => (
							<div class="rounded-cards border-line bg-surface hover:border-primary/50 border p-6 transition hover:-translate-y-0.5">
								<span class="text-2xl">{feature.icon}</span>
								<h3 class="text-ink mt-3 font-semibold">{feature.title}</h3>
								<p class="text-muted mt-1 text-sm">{feature.description}</p>
							</div>
						))}
					</div>
				</div>
			</section>

			<section class="border-line border-t">
				<div class="mx-auto max-w-2xl px-4 py-16 text-center lg:px-8">
					<h2 class="text-ink text-2xl font-semibold">
						Deja de perder enlaces útiles
					</h2>
					<p class="text-muted mt-2 text-sm">
						Crea tu cuenta gratis y empieza a guardar en menos de un minuto.
					</p>
					<a
						href="/register"
						class="rounded-buttons bg-primary text-on-primary hover:bg-primary-active mt-6 inline-block px-6 py-3 text-sm font-semibold transition hover:-translate-y-0.5"
					>
						Crear cuenta gratis
					</a>
				</div>
			</section>
		</main>

		<footer class="border-line border-t">
			<div class="text-subtle mx-auto max-w-6xl px-4 py-6 text-center text-xs lg:px-8">
				LinksStore · hecho para no volver a perder un enlace
			</div>
		</footer>
	</div>
</Layout>

<style>
	@keyframes rise-in {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.rise {
		animation: rise-in 0.7s var(--ease-standard) backwards;
	}
	.rise-1 {
		animation-delay: 0.05s;
	}
	.rise-2 {
		animation-delay: 0.14s;
	}
	.rise-3 {
		animation-delay: 0.22s;
	}
	.rise-4 {
		animation-delay: 0.3s;
	}
	.rise-5 {
		animation-delay: 0.38s;
	}

	@media (prefers-reduced-motion: reduce) {
		.rise {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
