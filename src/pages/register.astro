---
import { eq } from 'drizzle-orm';
import { db } from '../db/client';
import { users } from '../db/schema';
import Layout from '../layouts/Layout.astro';
import { hashPassword } from '../lib/password';
import { createSession, setSessionCookie } from '../lib/session';

if (Astro.locals.user) {
	return Astro.redirect('/');
}

let error: string | null = null;
let email = '';

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	email = String(formData.get('email') ?? '')
		.trim()
		.toLowerCase();
	const password = String(formData.get('password') ?? '');

	if (!email || !email.includes('@')) {
		error = 'Ingresa un correo válido.';
	} else if (password.length < 8) {
		error = 'La contraseña debe tener al menos 8 caracteres.';
	} else {
		const [existing] = await db
			.select({ id: users.id })
			.from(users)
			.where(eq(users.email, email))
			.limit(1);

		if (existing) {
			error = 'Ya existe una cuenta con este correo.';
		} else {
			const passwordHash = await hashPassword(password);
			const [user] = await db
				.insert(users)
				.values({ email, passwordHash })
				.returning();
			const session = await createSession(user.id);
			setSessionCookie(Astro.cookies, session);
			return Astro.redirect('/');
		}
	}
}
---

<Layout title="Crear cuenta · LinksStore">
	<main class="flex min-h-screen items-center justify-center p-4">
		<form
			method="POST"
			class="rounded-cards border-line bg-surface w-full max-w-sm border p-6"
		>
			<h1 class="text-ink mb-4 text-lg font-semibold">Crear cuenta</h1>

			{error && <p class="text-danger mb-4 text-sm">{error}</p>}

			<label class="text-muted mb-3 flex flex-col gap-1 text-sm">
				Correo
				<input
					type="email"
					name="email"
					required
					value={email}
					class="rounded-buttons border-line bg-canvas text-ink focus:border-primary border px-3 py-2 text-sm outline-none"
				/>
			</label>

			<label class="text-muted mb-4 flex flex-col gap-1 text-sm">
				Contraseña
				<input
					type="password"
					name="password"
					required
					minlength="8"
					class="rounded-buttons border-line bg-canvas text-ink focus:border-primary border px-3 py-2 text-sm outline-none"
				/>
			</label>

			<button
				type="submit"
				class="rounded-buttons bg-primary text-on-primary hover:bg-primary-active w-full px-4 py-2 text-sm font-semibold"
			>
				Crear cuenta
			</button>

			<p class="text-subtle mt-4 text-sm">
				¿Ya tienes cuenta?{' '}
				<a
					href="/login"
					class="text-ink decoration-primary hover:decoration-2 underline underline-offset-2"
				>
					Inicia sesión
				</a>
			</p>
		</form>
	</main>
</Layout>
