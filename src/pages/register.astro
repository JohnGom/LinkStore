---
import { eq } from 'drizzle-orm';
import { db } from '../db/client';
import { users } from '../db/schema';
import Layout from '../layouts/Layout.astro';
import { hashPassword } from '../lib/password';
import { createSession, setSessionCookie } from '../lib/session';

if (Astro.locals.user) {
	return Astro.redirect('/');
}

let error: string | null = null;
let email = '';

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	email = String(formData.get('email') ?? '')
		.trim()
		.toLowerCase();
	const password = String(formData.get('password') ?? '');

	if (!email || !email.includes('@')) {
		error = 'Ingresa un correo válido.';
	} else if (password.length < 8) {
		error = 'La contraseña debe tener al menos 8 caracteres.';
	} else {
		const [existing] = await db
			.select({ id: users.id })
			.from(users)
			.where(eq(users.email, email))
			.limit(1);

		if (existing) {
			error = 'Ya existe una cuenta con este correo.';
		} else {
			const passwordHash = await hashPassword(password);
			const [user] = await db
				.insert(users)
				.values({ email, passwordHash })
				.returning();
			const session = await createSession(user.id);
			setSessionCookie(Astro.cookies, session);
			return Astro.redirect('/');
		}
	}
}
---

<Layout title="Crear cuenta · LinksStore">
	<main class="flex min-h-screen items-center justify-center p-4">
		<form
			method="POST"
			class="shadow-card rounded-cards border-steel-border bg-indigo-surface w-full max-w-sm border p-6"
		>
			<h1 class="font-display text-paper-white mb-4 text-lg font-semibold">
				Crear cuenta
			</h1>

			{error && <p class="text-tag-coral mb-4 text-sm font-thin">{error}</p>}

			<label class="text-fog mb-3 flex flex-col gap-1 text-sm font-thin">
				Correo
				<input
					type="email"
					name="email"
					required
					value={email}
					class="rounded-buttons border-steel-border bg-midnight-canvas text-paper-white focus:border-signal-blue border px-3 py-2 text-sm outline-none"
				/>
			</label>

			<label class="text-fog mb-4 flex flex-col gap-1 text-sm font-thin">
				Contraseña
				<input
					type="password"
					name="password"
					required
					minlength="8"
					class="rounded-buttons border-steel-border bg-midnight-canvas text-paper-white focus:border-signal-blue border px-3 py-2 text-sm outline-none"
				/>
			</label>

			<button
				type="submit"
				class="rounded-buttons bg-signal-blue text-paper-white hover:bg-signal-blue/90 w-full px-4 py-2 text-sm font-thin"
			>
				Crear cuenta
			</button>

			<p class="text-mist mt-4 text-sm font-thin">
				¿Ya tienes cuenta?{' '}
				<a href="/login" class="text-signal-blue">
					Inicia sesión
				</a>
			</p>
		</form>
	</main>
</Layout>
