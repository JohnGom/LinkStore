<button
	id="theme-toggle"
	type="button"
	aria-label="Cambiar tema claro/oscuro"
	title="Cambiar tema"
	class="border-line bg-surface text-ink hover:border-primary flex h-9 w-9 shrink-0 items-center justify-center rounded-full border transition-colors"
>
	<span class="theme-icon-dark">🌙</span>
	<span class="theme-icon-light">☀️</span>
</button>

<style>
	.theme-icon-light {
		display: none;
	}
	:global(:root[data-theme='light']) .theme-icon-dark {
		display: none;
	}
	:global(:root[data-theme='light']) .theme-icon-light {
		display: inline;
	}
</style>

<script is:inline>
	(function () {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return;
		btn.addEventListener('click', function () {
			const current =
				document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
			const next = current === 'light' ? 'dark' : 'light';
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {
				// localStorage puede no estar disponible (modo privado); el tema no persiste entre recargas.
			}
		});
	})();
</script>
