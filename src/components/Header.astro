---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	userEmail?: string;
}

const { userEmail } = Astro.props;
---

<header class="border-line border-b">
	<div class="mx-auto flex max-w-6xl items-center gap-2 px-4 py-4 lg:px-8">
		<Logo href="/app" />

		<div class="ml-auto flex items-center gap-3">
			<ThemeToggle />

			{userEmail && (
				<>
					<span class="text-subtle hidden text-sm sm:inline">{userEmail}</span>
					<form method="POST" action="/logout">
						<button
							type="submit"
							class="rounded-buttons border-line text-ink hover:bg-surface-elevated border px-3 py-1.5 text-sm font-medium"
						>
							Cerrar sesión
						</button>
					</form>
				</>
			)}
		</div>
	</div>
</header>
