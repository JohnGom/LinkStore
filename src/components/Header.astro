---
interface Props {
	userEmail?: string;
}

const { userEmail } = Astro.props;
---

<header class="border-b border-steel-border/60">
	<div class="mx-auto flex max-w-6xl items-center gap-2 px-4 py-4 lg:px-8">
		<span class="rounded-images flex h-8 w-8 items-center justify-center bg-white text-base">
			🔗
		</span>
		<span class="font-display text-paper-white text-lg font-semibold">
			LinksStore
		</span>

		<div class="ml-auto flex items-center gap-3">
			<button
				id="theme-toggle"
				type="button"
				aria-label="Cambiar tema claro/oscuro"
				title="Cambiar tema"
				class="text-paper-white hover:bg-cobalt-surface rounded-full p-2"
			>
				<span class="theme-icon-dark">🌙</span>
				<span class="theme-icon-light">☀️</span>
			</button>

			{userEmail && (
				<>
					<span class="text-mist hidden text-sm font-thin sm:inline">
						{userEmail}
					</span>
					<form method="POST" action="/logout">
						<button
							type="submit"
							class="rounded-buttons border-paper-white/20 text-paper-white hover:bg-indigo-surface border px-3 py-1.5 text-sm font-thin"
						>
							Cerrar sesión
						</button>
					</form>
				</>
			)}
		</div>
	</div>
</header>

<style>
	.theme-icon-light {
		display: none;
	}
	:global(:root[data-theme='light']) .theme-icon-dark {
		display: none;
	}
	:global(:root[data-theme='light']) .theme-icon-light {
		display: inline;
	}
</style>

<script is:inline>
	(function () {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return;
		btn.addEventListener('click', function () {
			const current =
				document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
			const next = current === 'light' ? 'dark' : 'light';
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {
				// localStorage puede no estar disponible (modo privado); el tema no persiste entre recargas.
			}
		});
	})();
</script>
