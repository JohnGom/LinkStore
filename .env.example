POSTGRES_USER=linksstore
POSTGRES_PASSWORD=linksstore
POSTGRES_DB=linksstore
POSTGRES_PORT=5433

# Usada por las herramientas que corren en tu máquina (drizzle-kit, el
# script de seed, `astro dev`): apunta al puerto expuesto en el host.
DATABASE_URL=postgresql://linksstore:linksstore@localhost:5433/linksstore

# Puerto en el host donde queda disponible la app cuando corre en Docker
# (docker compose up). Dentro del contenedor, la app se conecta a Postgres
# por la red interna de Compose (host "db"), no por este archivo .env.
APP_PORT=3000
